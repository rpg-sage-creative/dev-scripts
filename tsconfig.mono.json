/*
Each package/submodule in rpg-sage will use tsconfig.mono.json to ensure proper build order.
*/
{
	"extends": "../../../tsconfig.json",
	"compilerOptions": {
		"composite": true,
		"outDir": "./mjs",
		"rootDir": "./src",
	},
	"exclude": [
		"./test"
	],
	"include": [
		"./src"
	],
	"references": [
		// { "path": "" },
	],
}
